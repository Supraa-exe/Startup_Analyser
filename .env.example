# Core MiroFish Server Settings (Optional - enables live proxy mode)
MIROFISH_LIVE_URL=http://localhost:5001

# 1. LLM API Key (OpenAI / OpenRouter / DeepSeek / Bailian):
#    https://platform.openai.com/api-keys
LLM_API_KEY=your_openai_or_compatible_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# 2. Zep Cloud API Key (Graph Memory for MiroFish GraphRAG):
#    https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# 3. Google AI Studio / Gemini API Key (Gemini 2.5 Flash / Gemma structuring & comparisons):
#    https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. MongoDB Atlas (Cloud database for World Archive):
#    https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# 5. ElevenLabs API Key (Voiced briefings & objections):
#    https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 6. Backboard API Key (Cross-run founder memory):
#    https://backboard.ai/
BACKBOARD_API_KEY=your_backboard_api_key_here

# 7. Crawl4AI Cloud Key (URL-to-startup auto-import feature - optional):
#    https://crawl4ai.com/
CRAWL4AI_API_KEY=
